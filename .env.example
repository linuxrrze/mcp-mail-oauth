# mcp-mail-oauth configuration. Reasons for every default: docs/decisions.md.

# ── Inbound auth: which tokens this server accepts ───────────────────────────
# `iss` of the tokens, exactly (Keycloak: <public frontend URL>/realms/<realm>).
OIDC_ISSUER=https://sso.example.com/realms/mail
# Optional: JWKS URL if this container reaches Keycloak under another hostname
# than the public issuer (e.g. http://keycloak:8080/realms/mail/protocol/openid-connect/certs).
# Unset = read it from the issuer's discovery document at startup.
#OIDC_JWKS_URI=
# Tokens must carry this in `aud` (Keycloak: audience mapper in the `mail` scope).
MCP_AUDIENCE=mcp-mail
# Public URL of this server (protected-resource metadata; proxy-mode callbacks).
# Include a reverse-proxy sub-directory if there is one, without a trailing
# slash, e.g. https://ai.example.com/mcp/mail-oauth (docs/reverse-proxy.md).
BASE_URL=https://mcp-mail.example.com

# resource (default): accept forwarded Keycloak tokens only, e.g. from Open
#   WebUI's MCP auth type "OAuth". Stateless, no Keycloak client needed.
# proxy: additionally run the MCP OAuth flow with Dynamic Client Registration
#   for generic MCP clients (Claude Desktop, MCP Inspector, Open WebUI "OAuth 2.1").
AUTH_MODE=resource
# proxy mode only:
#OIDC_CLIENT_ID=mcp-mail
#OIDC_CLIENT_SECRET=
# proxy mode only, recommended: signs this server's own session tokens and
# keys its encrypted store. Unset = derived from OIDC_CLIENT_SECRET, so
# rotating that secret would drop all client registrations and sessions.
#JWT_SIGNING_KEY=

# ── Mail server ──────────────────────────────────────────────────────────────
MAIL_IMAP_HOST=mail.example.com
# tls (implicit TLS, default port 993) | starttls (default port 143).
# There is deliberately no plaintext option: the credential is a bearer token.
MAIL_IMAP_SECURITY=tls
#MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=mail.example.com
# starttls (default port 587) | tls (default port 465)
MAIL_SMTP_SECURITY=starttls
#MAIL_SMTP_PORT=587
# XOAUTH2 (default) | OAUTHBEARER (RFC 7628). Dovecot supports both.
MAIL_SASL_MECHANISM=XOAUTH2
# Token claim used as the IMAP/SMTP login name and From address. Must equal
# Dovecot's oauth2 username_attribute.
MAIL_USERNAME_CLAIM=email
# PEM bundle that replaces the system trust store (private CA). Unset = system CAs.
#MAIL_CA_FILE=/certs/ca.pem
# Keycloak with a private CA: PEM bundle for the OIDC/JWKS calls, replacing
# the system trust store (MAIL_CA_FILE doesn't cover these).
#SSL_CERT_FILE=/certs/ca-bundle.pem
# Folder that receives a copy of sent mail. Empty value = don't save a copy.
MAIL_SENT_FOLDER=Sent
MAIL_TIMEOUT=30

# ── Runtime ──────────────────────────────────────────────────────────────────
# This package's log level. FastMCP's own logger uses FASTMCP_LOG_LEVEL.
# Tokens are never logged at any level.
LOG_LEVEL=INFO
#HOST=0.0.0.0
#PORT=8000
