{
  "realm": "mail",
  "displayName": "mcp-mail-oauth test realm",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "clientScopes": [
    {
      "name": "mail",
      "description": "Mailbox access via OAuth (IMAP/SMTP). Carries the two audiences the token needs: this MCP server (MCP_AUDIENCE) and the client Dovecot introspects with. Dovecot's oauth2 `scope = mail` requires it. See docs/keycloak.md.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Access your mailbox"
      },
      "protocolMappers": [
        {
          "name": "audience-mcp-mail",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "mcp-mail",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        },
        {
          "name": "audience-dovecot",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "dovecot",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        }
      ]
    },
    {
      "name": "mcp:mail/read",
      "description": "MCP tools: list folders, list/search/read messages",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Read your email"
      },
      "protocolMappers": []
    },
    {
      "name": "mcp:mail/send",
      "description": "MCP tool: send_message",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Send email on your behalf"
      },
      "protocolMappers": []
    }
  ],
  "clients": [
    {
      "clientId": "openwebui",
      "name": "Open WebUI",
      "description": "Open WebUI's own SSO login. Its access token is forwarded to mcp-mail-oauth (MCP auth type 'OAuth') and from there to Dovecot/Postfix, so the mail scopes are DEFAULT scopes here (Open WebUI doesn't request them).",
      "enabled": true,
      "publicClient": false,
      "secret": "openwebui-test-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": ["http://localhost:3000/oauth/oidc/callback"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": ["web-origins", "acr", "roles", "profile", "basic", "email", "mail", "mcp:mail/read", "mcp:mail/send"],
      "optionalClientScopes": ["offline_access"]
    },
    {
      "clientId": "dovecot",
      "name": "Dovecot token introspection",
      "description": "Credentials Dovecot's oauth2 passdb uses to call the introspection endpoint. No login flow of any kind. Must appear in the token's aud (Keycloak 26.6.2+), which the `mail` client scope ensures.",
      "enabled": true,
      "publicClient": false,
      "secret": "dovecot-test-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [],
      "defaultClientScopes": [],
      "optionalClientScopes": []
    },
    {
      "clientId": "mcp-mail",
      "name": "mcp-mail-oauth (AUTH_MODE=proxy only)",
      "description": "Only needed for AUTH_MODE=proxy: FastMCP's OIDCProxy logs generic MCP clients (Claude Desktop, MCP Inspector, Open WebUI 'OAuth 2.1') in through this client. Delete it if every client forwards an Open WebUI token.",
      "enabled": true,
      "publicClient": false,
      "secret": "mcp-mail-test-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": ["http://localhost:8000/auth/callback"],
      "webOrigins": ["http://localhost:8000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": ["web-origins", "acr", "roles", "profile", "basic", "email", "mail", "mcp:mail/read", "mcp:mail/send"],
      "optionalClientScopes": ["offline_access"]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "email": "alice@example.com",
      "firstName": "Alice",
      "lastName": "Example",
      "credentials": [{"type": "password", "value": "alice", "temporary": false}],
      "requiredActions": []
    }
  ]
}
