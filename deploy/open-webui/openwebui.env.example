# Open WebUI settings relevant to mcp-mail-oauth (see docs/open-webui.md).
# Merge into your existing Open WebUI environment.

# Must be set and stable: Open WebUI encrypts stored OAuth sessions with it.
# If it changes (or is generated per container start), every forwarded token
# becomes undecryptable and mail tools fail until users log in again.
WEBUI_SECRET_KEY=CHANGE_ME_LONG_RANDOM_STRING
WEBUI_URL=https://openwebui.example.com

ENABLE_OAUTH_SIGNUP=true
OAUTH_PROVIDER_NAME=Keycloak
OPENID_PROVIDER_URL=https://sso.example.com/realms/mail/.well-known/openid-configuration
OAUTH_CLIENT_ID=openwebui
OAUTH_CLIENT_SECRET=CHANGE_ME
OPENID_REDIRECT_URI=https://openwebui.example.com/oauth/oidc/callback

# The mail scopes (mail, mcp:mail/read, mcp:mail/send) are DEFAULT client
# scopes in Keycloak, so they're in the token without being listed here.
# offline_access is recommended: Open WebUI refreshes the forwarded token
# with the refresh token, and a normal refresh token dies with Keycloak's SSO
# idle timeout (default 30 min) - after which mail tools stop working until
# the user logs in again. See docs/decisions.md, D16.
OAUTH_SCOPES=openid email profile offline_access
